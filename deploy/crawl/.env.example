# deploy/crawl/compose.yaml is started with `--env-file /opt/jobboard/.env` (the app's .env), so these keys
# live THERE, not in a separate file. This lists what the crawl stack reads from it.
#
# required
OPENAI_API_KEY=                 # already in the app .env; Firecrawl uses it for JSON extraction (MODEL_NAME)
SEARXNG_SECRET=                 # cookie/signing secret for SearXNG; deploy/bootstrap.sh appends one if missing
#
# optional tuning (defaults in compose.yaml)
#FIRECRAWL_WORKERS=2            # NUM_WORKERS_PER_QUEUE
#FIRECRAWL_MAX_CONCURRENT_JOBS=2
#FIRECRAWL_CONCURRENT_REQUESTS=3   # also Playwright's MAX_CONCURRENT_PAGES
#FIRECRAWL_MODEL=gpt-4o-mini
#FIRECRAWL_LOG_LEVEL=info
#
# dev (jobboard/dev.sh up-fc): the same keys come from your shell or jobboard/.env; dev.sh supplies a
# throwaway SEARXNG_SECRET when none is set.
